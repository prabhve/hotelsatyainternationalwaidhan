{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Authenticated guest or staff profile storing PII strictly isolated to owner and admins.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["guest"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Room reservation record for Hotel Satya International.",
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "guestName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "guestEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "guestPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 25
        },
        "roomId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "occupancy": {
          "type": "string",
          "enum": ["Single", "Double"]
        },
        "mealPlan": {
          "type": "string",
          "enum": ["EP", "CP", "MAP", "AP"]
        },
        "checkInDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "checkOutDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "nights": {
          "type": "integer"
        },
        "adults": {
          "type": "integer"
        },
        "children": {
          "type": "integer"
        },
        "totalInr": {
          "type": "number"
        },
        "specialRequests": {
          "type": "string",
          "maxLength": 600
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "bookingId",
        "userId",
        "guestName",
        "guestEmail",
        "guestPhone",
        "roomId",
        "roomTitle",
        "occupancy",
        "mealPlan",
        "checkInDate",
        "checkOutDate",
        "nights",
        "adults",
        "children",
        "totalInr",
        "specialRequests",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "Public guest review for Hotel Satya International with multi-dimensional hospitality scores and zero PII.",
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "stayCategory": {
          "type": "string",
          "enum": ["Business", "Family", "Wedding & Events", "Solo"]
        },
        "roomStayed": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "rating": {
          "type": "number"
        },
        "cleanlinessRating": {
          "type": "number"
        },
        "diningRating": {
          "type": "number"
        },
        "hospitalityRating": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "comment": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1200
        },
        "verifiedStay": {
          "type": "boolean"
        },
        "ownerReply": {
          "type": "string",
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "reviewId",
        "userId",
        "authorName",
        "stayCategory",
        "roomStayed",
        "rating",
        "cleanlinessRating",
        "diningRating",
        "hospitalityRating",
        "title",
        "comment",
        "verifiedStay",
        "ownerReply",
        "createdAt",
        "updatedAt"
      ]
    },
    "EventInquiry": {
      "title": "EventInquiry",
      "description": "Banquet, lawn wedding, or corporate conference inquiry.",
      "type": "object",
      "properties": {
        "inquiryId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "contactName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "contactPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 25
        },
        "venue": {
          "type": "string",
          "enum": ["Open-Air Lawn (3000 Pax)", "Grand Banquet Hall (200 Pax)", "Party Room (40 Pax)", "Executive Meeting Room (20 Pax)"]
        },
        "eventDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "guestCount": {
          "type": "integer"
        },
        "notes": {
          "type": "string",
          "maxLength": 600
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "inquiryId",
        "userId",
        "contactName",
        "contactPhone",
        "venue",
        "eventDate",
        "guestCount",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted admin UID registry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private user profiles containing PII; strictly restricted to owner and admins."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Guest room reservations; readable/listable only by booking owner or admin."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Public verified hospitality reviews; readable by anyone, writable by authenticated owner or admin."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/EventInquiry" },
      "description": "Banquet and corporate conference inquiries; readable/listable only by submitter or admin."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin role marker collection; read-only to self/admin, no client writes."
    }
  }
}
